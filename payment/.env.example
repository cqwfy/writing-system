# 数据库
DATABASE_URL=mysql://root:password@localhost:3306/school_db

# JWT
JWT_SECRET=change-me-to-a-random-64-char-string
JWT_REFRESH_SECRET=change-me-to-another-random-64-char-string
JWT_ACCESS_EXPIRES=2h
JWT_REFRESH_EXPIRES=7d

# 微信小程序
WECHAT_APP_ID=wxXXXXXXXX
WECHAT_APP_SECRET=XXXXXXXX

# 微信支付
WECHAT_MCH_ID=XXXXXXXX
WECHAT_API_KEY_V3=XXXXXXXX
WECHAT_PRIVATE_KEY_PATH=/path/to/apiclient_key.pem
WECHAT_SERIAL_NO=XXXXXXXX

# 腾讯云 COS
COS_SECRET_ID=XXXXXXXX
COS_SECRET_KEY=XXXXXXXX
COS_BUCKET=school-avatar-xxx
COS_REGION=ap-guangzhou

# 应用
PORT=3000
NODE_ENV=development
UPLOAD_MAX_SIZE=10485760
CORS_ORIGIN=http://localhost:5173
