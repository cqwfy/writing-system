<view class="container">
  <view class="nav-bar">
    <view class="nav-back" bindtap="goBack">← 返回</view>
    <view class="nav-title">个人中心</view>
  </view>
  <view class="profile-header">
    <view class="avatar">👤</view>
    <view class="name">{{displayName}}</view>
    <view class="role">{{displayRole}}</view>
  </view>

  <view class="info-card" wx:if="{{profile}}">
    <view class="card-title">基本信息</view>
    <view class="info-row" wx:if="{{profile.student}}">
      <text class="info-label">学号</text>
      <text class="info-value">{{profile.student.studentNo}}</text>
    </view>
    <view class="info-row" wx:if="{{profile.student}}">
      <text class="info-label">班级</text>
      <text class="info-value">{{profile.student.className || '-'}}</text>
    </view>
    <view class="info-row" wx:if="{{profile.parent}}">
      <text class="info-label">关联学生</text>
      <text class="info-value">{{profile.parent.studentName || '-'}}</text>
    </view>
    <view class="info-row" wx:if="{{profile.phone}}">
      <text class="info-label">手机号</text>
      <text class="info-value">{{profile.phone}}</text>
    </view>
  </view>

  <view class="action-list">
    <button class="logout-btn" bindtap="handleLogout">退出登录</button>
  </view>
</view>
